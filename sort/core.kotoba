;; sort -- POSIX sort (IEEE Std 1003.1) for ONE operand, byte order.
;;
;;   sort FILE     the lines, ascending
;;
;; ## No ordering primitive was needed, and that is worth stating
;;
;; The language has no string comparison but `string=`, which is why
;; `org-ieee-ls` records `-a` as needing "a merge into byte order" it could
;; not do. It does not need a primitive: UTF-8 preserves code point order
;; lexicographically, so walking both strings with `string-code-point-at` and
;; comparing code points gives exactly byte order. `less?` below is that walk.
;;
;; ## Byte order, so the comparison is `LC_ALL=C sort`
;;
;; Measured 2026-09-10 on `b a B A`: the default locale answers `a A b B` and
;; LC_ALL=C answers `A B a b`. On `日 é z` the default answers `日 é z` and
;; LC_ALL=C answers `z é 日`. This produces the second in both cases -- the
;; POSIX locale -- and the test compares against it.
;;
;; ## sort ADDS the newline a last line lacks
;;
;; Measured: a 13-byte file whose last line has no newline produces 14 bytes.
;; Same as grep, opposite of head.
;;
;; ## Selection sort, and why
;;
;; Substrings are VIEWS and cost no arena bytes; `string-concat` is what
;; allocates, and the arena never reclaims. So the shape that matters is how
;; many concatenations happen, not how many comparisons. Selection sort emits
;; the minimum and rebuilds the remainder once per line -- O(n) concatenations
;; per line -- rather than building a sorted accumulator, which would
;; concatenate on every comparison.
(ns sort.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn slurp-file [path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

;; Is PATH a file this command may read? Wire 35's EXISTS form answers "1" or
;; "0"; a path outside the granted scope answers "0", which is what the read
;; form would trap on.
;;
;; This has to be ASKED. The read form TRAPS on a path it cannot serve, and a
;; trap cannot be caught, so there is no way to notice afterwards.
(defn readable? [path :string] :bool
  (string=? (typed-cap-call :fs/app-data :string :string
                            (string-concat path "EXISTS_SEP"))
            "1"))


(defn nl [] :string
  (string-substring "a
b" 1 2))

;; The UTF-8 width of the code point starting at byte offset I, from its
;; VALUE -- the contract `string-code-point-at` states.
(defn cp-width [c :i64] :i64
  (if (< c 128) 1 (if (< c 2048) 2 (if (< c 65536) 3 4))))

;; Is A strictly less than B in byte order? Walks both by code points; UTF-8
;; keeps code point order and byte order the same, so this IS byte order. A
;; proper prefix is less than what extends it.
;;
;; The lengths are recomputed each step rather than carried. Six parameters
;; exceeded the native ABI's supported arity -- `function parameters exceed
;; ABI-supported arity` -- and `string-byte-length` is a host callback, so
;; asking twice per step costs no fuel and no arena.
(defn less-from [a :string b :string i :i64 j :i64] :bool
  (if (>= i (string-byte-length a))
    (if (>= j (string-byte-length b)) false true)
    (if (>= j (string-byte-length b))
      false
      (let [ca (string-code-point-at a i)
            cb (string-code-point-at b j)]
        (if (< ca cb)
          true
          (if (> ca cb)
            false
            (less-from a b (+ i (cp-width ca)) (+ j (cp-width cb)))))))))

(defn less? [a :string b :string] :bool
  (less-from a b 0 0))

;; --- the line list, carried as one "\n"-joined string ---------------------

(defn first-line [s :string] :string
  (let [i (string-index-of s "\n")]
    (if (< i 0) s (string-substring s 0 i))))

(defn rest-lines [s :string] :string
  (let [i (string-index-of s "\n")]
    (if (< i 0) "" (string-substring s (+ i 1) (string-byte-length s)))))

(defn append-line [acc :string x :string] :string
  (if (= (string-byte-length acc) 0)
    x
    (string-concat (string-concat acc (nl)) x)))

;; The smallest line of S, given a candidate BEST already taken from it.
(defn min-line [s :string best :string] :string
  (if (= (string-byte-length s) 0)
    best
    (let [head (first-line s)]
      (min-line (rest-lines s) (if (less? head best) head best)))))

;; S without its FIRST line equal to TARGET. Duplicates are kept: only one
;; occurrence is removed per pass, which is what makes `dup dup a` answer
;; `a dup dup` and not `a dup`.
(defn drop-one [s :string target :string acc :string done :bool] :string
  (if (= (string-byte-length s) 0)
    acc
    (let [head (first-line s)
          rest (rest-lines s)]
      (if (if done false (string=? head target))
        (drop-one rest target acc true)
        (drop-one rest target (append-line acc head) done)))))

(defn emit-sorted [s :string] :i64
  (if (= (string-byte-length s) 0)
    0
    (let [m (min-line (rest-lines s) (first-line s))]
      (do
        (emit m)
        (emit (nl))
        (emit-sorted (drop-one s m "" false))))))

;; There is no trim of the final newline, and its ABSENCE is deliberate.
;;
;; The first version had one, on the reasoning that a file ending in "\n"
;; would otherwise sort an empty line to the front. It never did: the walk
;; stops when the remainder is empty, so the piece after the last newline is
;; never produced as a line. The control that removed the trim passed all
;; nine cases -- which said the code was dead.
;;
;; It was worse than dead. A file ending in "\n\n" has a genuinely EMPTY last
;; line, and sort prints it. Measured 2026-09-10 on `a\n\n`: /usr/bin/sort
;; answers an empty line then `a`; with the trim this answered `a` alone.
;; The fixture that catches it is in the suite.

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

;; --- several operands ----------------------------------------------------
;;
;; sort MERGES its operands: there are no headers and the operand order does
;; not affect the output, since everything is sorted together. Duplicates
;; survive -- the same file twice yields every line twice.
;;
;; A file whose last line has NO trailing newline still contributes that line
;; WHOLE. Measured against /usr/bin/sort 2026-09-10, and it is the case that
;; separates reading operands as LINES from concatenating their bytes:
;;
;;   sort nn.txt s2.txt      -> a c x      (`x` is its own line)
;;   cat nn.txt s2.txt | sort -> c xa      (`x` and `a` ran together)
;;
;; So each operand is terminated before the next is appended.
(defn terminated [text :string] :string
  (let [n (string-byte-length text)]
    (if (= n 0)
      text
      (if (string=? (string-substring text (- n 1) n) "\n")
        text
        (string-concat text (nl))))))

;; Every operand's text, joined and each one terminated.
(defn gather [i :i64 total :string acc :string] :string
  (if (string=? (decimal-of i) total)
    acc
    (gather (+ i 1) total
            (string-concat acc (terminated (slurp-file (arg (decimal-of i))))))))

;; sort writes NOTHING when an operand is unreadable -- not the readable ones
;; and not a partial answer. Measured: `sort s1 nope s2` exits 2 with empty
;; stdout, where cat and wc print what they could. So the operands are all
;; checked BEFORE any is read.
(defn all-readable? [i :i64 total :string] :bool
  (if (string=? (decimal-of i) total)
    true
    (if (readable? (arg (decimal-of i)))
      (all-readable? (+ i 1) total)
      false)))

(defn main [] :i64
  (let [total (arg "")]
    (if (string=? total "0")
      ;; No operand. POSIX reads standard input; there is no stdin
      ;; capability, so this refuses rather than pretending to have read an
      ;; empty one.
      2
      (if (all-readable? 0 total)
        (emit-sorted (gather 0 total ""))
        ;; `sort: No such file or directory`, exit 2. sort names NO path and
        ;; exits 2 where cat, wc, head and uniq name the path and exit 1 --
        ;; measured on each of them rather than assumed from one.
        (do
          (emit-error "sort: No such file or directory")
          (emit-error (nl))
          2)))))
